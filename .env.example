# Mystic AI — Environment Variables (example)
# Copy this file to `.env` and fill in real values. Never commit real secrets.

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL=file:./db/custom.db

# ─────────────────────────────────────────────
# Bootstrap Admin (used by `bun run scripts/seed.ts`)
# The first user seeded becomes SUPER_ADMIN.
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Mystic Admin

# ─────────────────────────────────────────────
# App / Domain
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=Mystic AI

# ─────────────────────────────────────────────
# Cloudflare R2 (artifact storage, S3-compatible)
# Get these from Cloudflare dashboard → R2 → Manage R2 API Tokens
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=mystic-artifacts
# Optional — set if you configured a public custom domain on the R2 bucket:
# R2_PUBLIC_BASE_URL=https://artifacts.your-domain.com

# ─────────────────────────────────────────────
# Cloudflare API (account-level operations, optional)
# ─────────────────────────────────────────────
# CLOUDFLARE_API_TOKEN=cfat_...
# CLOUDFLARE_ACCOUNT_ID=...

# ─────────────────────────────────────────────
# AI Provider — OpenRouter (unified gateway for all 5 engines)
# One key covers Claude, Gemini, GLM, Codex, and Research roles.
# Get your key at https://openrouter.ai/keys
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# Super Admin API budget bonus (displayed in admin panel)
SUPER_ADMIN_API_BUDGET_USD=250.00
SUPER_ADMIN_API_BUDGET_PERIOD=monthly

# Native provider keys (optional — OpenRouter is used by default)
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# ZAI_API_KEY=...

# ─────────────────────────────────────────────
# Session security — set a long random string in production
# ─────────────────────────────────────────────
SESSION_SECRET=generate-a-long-random-string-here
